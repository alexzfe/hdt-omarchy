#!/usr/bin/env bash
# Launch Hearthstone Deck Tracker inside the Battle.net Wine prefix via umu-launcher + GE-Proton,
# so it shares a Wine session with Battle.net and Hearthstone (required for HDT to see the game).
#
# Installed by linux/install.sh. @HDT_INSTALL_DIR@ is filled in at install time.
#
# Environment: HDT_WINEPREFIX (default ~/Games/battlenet), HDT_PROTONPATH (GE-Proton; the newest
#              installed one is used, or whichever version already serves the prefix),
#              HDT_GAMEID (umu-hdt), HDT_NO_XERROR_SHIM=1 to run without the X error shim.
set -e

WINEPREFIX_DIR="${HDT_WINEPREFIX:-$HOME/Games/battlenet}"
HDT="@HDT_INSTALL_DIR@/HearthstoneDeckTracker.exe"
# $LIB is expanded by the dynamic loader per process architecture (lib/x86_64-linux-gnu, lib/i386-linux-gnu, lib, lib32).
XERROR_SHIM_ROOT="$(dirname "@HDT_INSTALL_DIR@")"
XERROR_SHIM="$XERROR_SHIM_ROOT/\$LIB/libhdt-xerror-shim.so"

if [[ ! -f $HDT ]]; then
  echo "Hearthstone Deck Tracker is not installed at: $HDT" >&2
  echo "Build and install it with linux/install.sh from the hdt-omarchy checkout." >&2
  exit 1
fi
if ! command -v umu-run >/dev/null 2>&1; then
  echo "umu-run (umu-launcher) is not on PATH; it is required to run HDT in the Proton prefix." >&2
  echo "On Omarchy it comes with the Battle.net setup (omarchy-launch-battlenet); otherwise install umu-launcher." >&2
  exit 1
fi
if [[ ! -d $WINEPREFIX_DIR ]]; then
  echo "Wine prefix not found: $WINEPREFIX_DIR (set HDT_WINEPREFIX to the Battle.net prefix)." >&2
  exit 1
fi

# Run the prefix's wineserver outside umu's sandbox, so it can read the memory of a Hearthstone
# started from any Battle.net launch (see hdt-wineserver), and pin Proton to that server's version.
PROTON_DIR="$(HDT_WINEPREFIX="$WINEPREFIX_DIR" "@HDT_WINESERVER@")" || PROTON_DIR=""
PROTON_DIR="${PROTON_DIR:-${HDT_PROTONPATH:-GE-Proton}}"

# Proton's Wine exits on an XInput error when XWayland disables a pointer device mid-session
# (see linux/hdt-xerror-shim.c). Preload the shim so those errors are logged instead of fatal.
# Note: LD_PRELOAD reaches every process umu starts, Hearthstone included when HDT launches it.
if [[ -f $XERROR_SHIM_ROOT/lib/x86_64-linux-gnu/libhdt-xerror-shim.so && -z ${HDT_NO_XERROR_SHIM:-} ]]; then
  export LD_PRELOAD="$XERROR_SHIM${LD_PRELOAD:+:$LD_PRELOAD}"
fi

# The umu game id only names this app: it becomes the X11 window class (steam_app_hdt), which
# the desktop entry and any compositor rules match on. The prefix is chosen by WINEPREFIX.
exec env \
  WINEPREFIX="$WINEPREFIX_DIR" \
  PROTONPATH="$PROTON_DIR" \
  GAMEID="${HDT_GAMEID:-umu-hdt}" \
  PROTON_VERB=run \
  umu-run "$HDT" "$@"
