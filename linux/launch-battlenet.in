#!/usr/bin/env bash
# Launch Battle.net like Omarchy's omarchy-launch-battlenet, but with the prefix's wineserver running
# outside umu's sandbox (see hdt-wineserver). Without this, a Battle.net started after HDT, or
# restarted while HDT stays open, runs Hearthstone in a sandbox the wineserver cannot read, and HDT's
# memory reading (Battlegrounds overlay, hovers, popups) stops working until everything is restarted.
#
# Installed by linux/install.sh, which points the Battle.net menu entry here. Options are the same
# as omarchy-launch-battlenet: [--with-mangohud].
# Environment: HDT_WINEPREFIX (default ~/Games/battlenet), HDT_PROTONPATH (see hdt-wineserver).
set -e

PREFIX="${HDT_WINEPREFIX:-$HOME/Games/battlenet}"
LAUNCHER="$PREFIX/drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe"

with_mangohud=0
for arg in "$@"; do
  case "$arg" in
    --with-mangohud) with_mangohud=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

if [[ ! -f $LAUNCHER ]]; then
  echo "Battle.net is not installed in $PREFIX. On Omarchy run omarchy-install-gaming-battlenet first." >&2
  exit 1
fi

PROTON_DIR="$(HDT_WINEPREFIX="$PREFIX" "@HDT_WINESERVER@")" || PROTON_DIR=""
PROTON_DIR="${PROTON_DIR:-${HDT_PROTONPATH:-GE-Proton}}"

env_args=(
  WINEPREFIX="$PREFIX"
  PROTONPATH="$PROTON_DIR"
  GAMEID=umu-battlenet
  PROTON_VERB=run
)
(( with_mangohud )) && env_args+=(MANGOHUD=1)

exec env "${env_args[@]}" umu-run "$LAUNCHER"
